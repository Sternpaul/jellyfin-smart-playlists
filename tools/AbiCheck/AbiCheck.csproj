<Project Sdk="Microsoft.NET.Sdk">
  <!-- Verifies that a built plugin DLL only references members that exist in a real
       Jellyfin server install. See Program.cs. Not part of the plugin solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>
</Project>
