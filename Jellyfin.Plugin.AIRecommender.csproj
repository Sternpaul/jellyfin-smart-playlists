<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.1.0</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <Authors>Sternpaul</Authors>
    <RepositoryUrl>https://github.com/Sternpaul/jellyfin-smart-playlists</RepositoryUrl>
    <Description>AI-powered smart playlists and recommendations for Jellyfin.</Description>
    <!-- No XML doc generation: this is a plugin, not a library; the .xml is unused
         and only produced 428 CS1591 "missing XML comment" warnings. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin Core Dependencies.
         ExcludeAssets=All -> the host (Jellyfin) already provides these at runtime.
         Copying them into the plugin output (via CopyLocalLockFileAssemblies) is wrong:
         it ships Jellyfin's own system assemblies + native runtimes inside the plugin,
         which crashes PluginManager.LoadAssemblies (Bad IL format on e_sqlite3.dll /
         native binaries) and can cause assembly-binding conflicts. -->
    <!-- Compile against the OLDEST supported host (Jellyfin 12.0) so the binary only
         references APIs every 12.x server has. Jellyfin 10.11 lives on legacy/10.11. -->
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" PrivateAssets="all" IncludeAssets="compile" />
    <!-- Jellyfin 12.x provides SkiaSharp 3.119.4 and its native library.
         Compile against that exact host assembly but never copy it into the plugin. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" PrivateAssets="all" IncludeAssets="compile" />

    <!-- SQLite for our local AI metadata cache. Jellyfin 12.0 ships EF Core 10.0.11;
         the release ZIP contains only our DLL, so this must not exceed the host's version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.AIRecommender.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <EmbeddedResource Include="Assets/Playlists/*.png" />
  </ItemGroup>

</Project>
