<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.7.0.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <Authors>Sternpaul</Authors>
    <RepositoryUrl>https://github.com/Sternpaul/jellyfin-smart-playlists</RepositoryUrl>
    <Description>AI-powered smart playlists and recommendations for Jellyfin.</Description>
    <!-- No XML doc generation: this is a plugin, not a library; the .xml is unused
         and only produced 428 CS1591 "missing XML comment" warnings. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin Core Dependencies.
         ExcludeAssets=All -> the host (Jellyfin) already provides these at runtime.
         Copying them into the plugin output (via CopyLocalLockFileAssemblies) is wrong:
         it ships Jellyfin's own system assemblies + native runtimes inside the plugin,
         which crashes PluginManager.LoadAssemblies (Bad IL format on e_sqlite3.dll /
         native binaries) and can cause assembly-binding conflicts. -->
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" PrivateAssets="all" IncludeAssets="compile" />
    
    <!-- SQLite for our local AI metadata cache -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
